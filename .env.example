# Runtime mode: local_native | distributed
SRE_RUNTIME_MODE=local_native
SRE_DATA_DIR=.local_data
SRE_API_HOST=127.0.0.1
SRE_API_PORT=8060

# Safety defaults: read_only by default; set to guarded_active only when approvals are active
SRE_AGENT_MODE=read_only
SRE_REQUIRE_APPROVAL=true
SRE_ENFORCE_SOD=true

# Optional OPA remote policy endpoint (falls back to embedded Rego-equivalent evaluator when unset)
OPA_POLICY_URL=

# Optional local LLM narration adapter (disabled by default; no pretrained weights downloaded)
ENABLE_LOCAL_LLM=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Development RBAC API keys (replace via secrets manager in production)
SRE_VIEWER_API_KEY=dev-viewer-key-readonly
SRE_OPERATOR_API_KEY=dev-operator-key-ops
SRE_APPROVER_API_KEY=dev-approver-key-gov

# Distributed stack endpoints (used with docker-compose.yml profiles)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
APICURIO_REGISTRY_URL=http://apicurio-registry:8080
LAKEKEEPER_URI=http://lakekeeper:8181/catalog
RUSTFS_ENDPOINT=http://rustfs:9000
MARQUEZ_URL=http://marquez:5000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_ARCH=arm64
