FROM python:3.12.8-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SRE_RUNTIME_MODE=local_native \
    SRE_API_HOST=0.0.0.0 \
    SRE_API_PORT=8060 \
    SRE_AGENT_MODE=read_only \
    ENABLE_LOCAL_LLM=false

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY agentic_sre ./agentic_sre
COPY ingestion ./ingestion
COPY models ./models
COPY services ./services
COPY apps ./apps
COPY schemas ./schemas
COPY sql ./sql
COPY infra/opa ./infra/opa
COPY scripts/entrypoint_standalone.sh ./scripts/entrypoint_standalone.sh

RUN pip install --no-cache-dir --upgrade pip==25.0.1 \
    && pip install --no-cache-dir . \
    && chmod +x /app/scripts/entrypoint_standalone.sh \
    && useradd --create-home --shell /bin/bash appuser \
    && mkdir -p /app/.local_data /app/results/pipeline \
    && chown -R appuser:appuser /app

USER appuser
EXPOSE 8060

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8060/health')" || exit 1

ENTRYPOINT ["/app/scripts/entrypoint_standalone.sh"]
